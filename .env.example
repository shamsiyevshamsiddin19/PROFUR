# ==========================================
# PROFUR Environment Configuration Template
# ==========================================
# Ushbu fayldan nusxa olib `.env` nomiga o'tkazing:
# cp .env.example .env
# Va qiymatlarni o'z muhitingizga moslang.

# Django umumiy sozlamalari
DEBUG=True
SECRET_KEY=django-insecure-profur-dev-key-change-in-production-!@#$12345
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL ma'lumotlar bazasi sozlamalari
DB_ENGINE=django.db.backends.postgresql
DB_NAME=profur_db
DB_USER=profur_user
DB_PASSWORD=profur_password
DB_HOST=localhost
DB_PORT=5432

# CORS (Frontend bilan integratsiya uchun)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
