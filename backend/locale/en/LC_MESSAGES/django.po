#: apps/accounts/models.py:19
msgid "Rol kodi"
msgstr "Role code"

#: apps/accounts/models.py:21
msgid ""
"Tizimda tekshirish uchun unikal identifikator (masalan: ADMIN, "
"WAREHOUSE_MANAGER)"
msgstr "Unique identifier for system checks (e.g., ADMIN, WAREHOUSE_MANAGER)"

#: apps/accounts/models.py:26
msgid "Rol nomi"
msgstr "Role name"

#: apps/accounts/models.py:27
msgid "Foydalanuvchi interfeysida ko'rinadigan nom"
msgstr "Display name in the user interface"

#: apps/accounts/models.py:31
msgid "Tavsif"
msgstr "Description"

#: apps/accounts/models.py:36
msgid "Ruxsatlar"
msgstr "Permissions"

#: apps/accounts/models.py:38
msgid ""
"Ruxsatlar ro'yxati (masalan: ['view_catalog', 'add_receipt', 'manage_users'])"
msgstr "List of permissions (e.g., ['view_catalog', 'add_receipt', 'manage_users'])"

#: apps/accounts/models.py:43
msgid "Tizimli rol"
msgstr "System role"

#: apps/accounts/models.py:44
msgid "Tizimning asosiy rollari tasodifan o'chirib yuborilmasligi uchun belgi"
msgstr "Flag to prevent accidental deletion of core system roles"

#: apps/accounts/models.py:48
msgid "Rol"
msgstr "Role"

#: apps/accounts/models.py:49 apps/accounts/models.py:67
msgid "Rollar"
msgstr "Roles"

#: apps/accounts/models.py:68
msgid "Foydalanuvchiga biriktirilgan rollar"
