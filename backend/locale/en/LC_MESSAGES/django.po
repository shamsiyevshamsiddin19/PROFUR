msgstr "This account has been deactivated."

#: apps/accounts/views.py:49
msgid "Tizimga muvaffaqiyatli kirildi."
msgstr "Successfully logged in."

#: apps/accounts/views.py:65
msgid "Tizimdan muvaffaqiyatli chiqildi."
msgstr "Successfully logged out."

#: apps/accounts/views.py
msgid "Foydalanuvchi topilmadi."
