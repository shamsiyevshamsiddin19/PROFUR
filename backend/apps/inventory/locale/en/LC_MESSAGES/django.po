msgid "chiqim"
msgstr "issue"

msgid "chiqimlar"
msgstr "issues"

msgid "chiqim sanasi"
msgstr "issue date"

msgid "kim oldi"
msgstr "recipient"

msgid "loyiha raqami"
msgstr "project number"

msgid "chiqim partiyasi"
msgstr "issue batch"

msgid "chiqim partiyalari"
msgstr "issue batches"

msgid "Chiqim sanasi kelajakda bo'lishi mumkin emas."
msgstr "The issue date cannot be in the future."

msgid "Bitta partiya ikki marta ko'rsatilgan."
msgstr "The same batch is listed twice."

msgid "Partiya bu materialga tegishli emas: {ids}."
msgstr "Batch does not belong to this material: {ids}."

msgid "Partiyada yetarli miqdor qolmagan."
msgstr "Not enough quantity left in the batch."

msgid "Omborda yetarli material yo'q."
msgstr "Not enough material in stock."

msgid "Butun son bo'lishi kerak."
msgstr "Must be a whole number."
