msgstr "дополнительные расходы"

msgid "Qo'shimcha xarajatlar"
msgstr "Дополнительные расходы"

msgid "Foydalanuvchi tilidagi nom."
msgstr "Название на языке пользователя."

msgid "Xarajat turining kodini o'zgartirib bo'lmaydi."
msgstr "Код типа расхода изменить нельзя."

msgid "Summa 0 dan katta bo'lishi kerak."
msgstr "Сумма должна быть больше 0."

msgid "Summada verguldan keyin ko'pi bilan 2 ta raqam bo'lsin."
msgstr "В сумме допускается не более 2 знаков после запятой."

msgid "Faqat USD valyutasi qabul qilinadi."
msgstr "Принимается только валюта USD."

msgid "Bu xarajat turi faol emas."
msgstr "Этот тип расхода неактивен."

msgid "Tugash sanasi boshlanish sanasidan oldin bo'lmasin."
msgstr "Дата окончания не может быть раньше даты начала."

msgid "bekor qilingan yozuv"
msgstr "отменённая запись"

msgid "Bu yozuvni bekor qilgan teskari yozuv (bo'lmasa null)."
msgstr "Сторнирующая запись, отменившая эту запись (иначе null)."

msgid "Bekor qilish sababini yozing."
msgstr "Укажите причину отмены."

msgid "Bu xarajat avval bekor qilingan."
msgstr "Этот расход уже отменён."

msgid "Teskari yozuvni bekor qilib bo'lmaydi."
msgstr "Сторнирующую запись нельзя отменить."
